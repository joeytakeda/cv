   <define name="cv.mixedContent">
      <zeroOrMore>
         <choice>
            <ref name="list"/>
            <text/>
            <ref name="title"/>
            <ref name="ref"/>
            <ref name="hi"/>
            <ref name="ptr"/>
         </choice>
      </zeroOrMore>
   </define>
   <define name="cv">
