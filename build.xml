<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="Build CV" default="all">

    <property name="echo.separator" value="****************************"/>
    <property name="message" value="'Updating CV.'"/>
    <property name="displayReferences">true</property>
    <property name="displayDesc">true</property>
    <property name="fontsize" value="12"/>
    <property name="fontFamily" value="Cormorant Garamond"/>
    <property name="pageHeight">11.00in</property>
    <property name="pageWidth">8.5in</property>
    <property name="marginTop">0.75in</property>
    <property name="marginBottom">0.75in</property>
    <property name="marginLeft">0.75in</property>
    <property name="marginRight">0.75in</property>
    <property name="showMonth">false</property>
    <property name="scale" value="major-second"/>
    <property name="source.dir" value="data"/>
    <property name="saxon" value="utilities/saxon-he-10.6.jar"/>

    <property name="out.dir" value="out"/>
    <property name="fo.dir" value="${basedir}"/>


    <!--Files-->
    <property name="source.cv" value="${source.dir}/CV.xml"/>
    <basename property="fname" file="${source.cv}" suffix="xml"/>
    <property name="html" value="${out.dir}/${fname}.html"/>
    <property name="tei" value="${out.dir}/${fname}.xml"/>
    <property name="fo" value="${out.dir}/${fname}.fo"/>
    <property name="pdf" value="${out.dir}/${fname}.pdf"/>

    <tstamp>
        <format property="date" pattern="yyyy-MM-dd" locale="en"/>
    </tstamp>

    <property name="fop.home" value="${basedir}/utilities/fop-2.11/fop"/>

    <taskdef name="fop" classname="org.apache.fop.tools.anttasks.Fop">
        <classpath>
            <fileset dir="${fop.home}/lib">
                <include name="*.jar"/>
            </fileset>
            <fileset dir="${fop.home}/build">
                <include name="*.jar"/>
            </fileset>
        </classpath>
    </taskdef>

    <target name="init">
        <echo message="${echo.separator}"/>
        <echo message="${echo.separator}"/>
        <echo message="Initiating CV Build."/>
        <echo message="${echo.separator}"/>
        <echo message="Transforming ${source.cv}"/>
        <echo message="${echo.separator}"/>
        <echo message="${echo.separator}"/>
        <echo message="Cleaning up old versions of the build."/>
        <delete dir="${out.dir}"/>
        <mkdir dir="${out.dir}"/>
    </target>

    <target name="xhtml">
        <echo message="${echo.separator}"/>
        <echo message="Creating XHTML5 version of the CV"/>
        <java classname="net.sf.saxon.Transform" classpath="${saxon}">
            <arg value="-s:${source.cv}"/>
            <arg value="-xsl:${basedir}/xsl/cv-to-xhtml.xsl"/>
            <arg value="-o:${html}"/>
            <arg value="date=${date}"/>
            <arg value="--suppressXsltNamespaceCheck:on"/>
        </java>
    </target>

    <target name="tei">
        <echo message="${echo.separator}"/>
        <echo message="Creating TEI version of CV"/>
        <java classname="net.sf.saxon.Transform" classpath="${saxon}">
            <arg value="-s:${source.cv}"/>
            <arg value="-xsl:${basedir}/xsl/cv-to-tei.xsl"/>
            <arg value="-o:${tei}"/>
            <arg value="date=${date}"/>
            <arg value="--suppressXsltNamespaceCheck:on"/>
        </java>
    </target>

    <target name="pdf">
        <echo message="${echo.separator}"/>
        <echo message="Creating PDF version of the CV"/>
        <java classname="net.sf.saxon.Transform" classpath="${saxon}">
            <arg value="-s:${source.cv}"/>
            <arg value="-xsl:${basedir}/xsl/cv-to-pdf.xsl"/>
            <arg value="-o:${fo}"/>
            <arg value="date=${date}"/>
            <arg value="displayReferences=${displayReferences}"/>
            <arg value="displayDesc=${displayDesc}"/>
            <arg value="fontsize=${fontsize}"/>
            <arg value="scale=${scale}"/>
            <arg value="fontFamily=${fontFamily}"/>
            <arg value="pageHeight=${pageHeight}"/>
            <arg value="pageWidth=${pageWidth}"/>
            <arg value="marginTop=${marginTop}"/>
            <arg value="marginBottom=${marginBottom}"/>
            <arg value="marginLeft=${marginLeft}"/>
            <arg value="marginRight=${marginRight}"/>
            <arg value="showMonth=${showMonth}"/>
            <arg value="--suppressXsltNamespaceCheck:on"/>
        </java>
        <property name="foPath" location="${fo}"/>
        <fop format="application/pdf" fofile="${foPath}" outfile="${pdf}"
            userconfig="${basedir}/utilities/fop.xconf"/>
    </target>

    <target name="list-fonts">
        <java classname="org.apache.fop.tools.fontlist.FontListMain">
            <classpath>
                <fileset dir="${fop.home}/lib">
                    <include name="*.jar"/>
                </fileset>
                <fileset dir="${fop.home}/build">
                    <include name="*.jar"/>
                </fileset>
            </classpath>
            <arg line="-c ${basedir}/utilities/fop.xconf"/>
        </java>
        
    </target>
    <target name="all">
        <antcall target="init"/>
<!--        <antcall target="xhtml"/>
        <antcall target="tei"/>-->
        <antcall target="pdf"/>
    </target>
</project>
